# Copy this file to .env (same folder) and paste your key after the = sign.
# .env stays on your computer: never email it, upload it or put it in a shared folder.
ROIC_API_KEY=
# SEC asks automated clients to say who they are: your firm's name and a monitored address.
SEC_USER_AGENT=Your Firm Name (client deck) compliance@yourfirm.com
